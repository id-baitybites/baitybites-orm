generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id           String       @id @default(cuid())
  name         String
  phone        String?      @unique
  email        String?      @unique
  address      String?
  city         String?      @default("Jakarta")
  customerType CustomerType @default(REGULAR) @map("customer_type")
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  googleId     String?      @unique @map("google_id")
  avatarUrl    String?      @map("avatar_url")
  district     String?
  postalCode   String?      @map("postal_code")
  orders       Order[]

  @@map("customers")
}

model Category {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  description  String?
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  products     Product[]

  @@map("categories")
}

model Product {
  id           String      @id @default(cuid())
  categoryId   String      @map("category_id")
  code         String      @unique
  name         String
  slug         String      @unique
  description  String?
  price        Float
  unit         String      @default("Pack")
  stock        Int         @default(0)
  imageUrl     String?     @map("image_url")
  badgeTag     String?     @map("badge_tag")
  isBestSeller Boolean     @default(false) @map("is_best_seller")
  isAvailable  Boolean     @default(true) @map("is_available")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  orderItems   OrderItem[]
  category     Category    @relation(fields: [categoryId], references: [id])

  @@map("products")
}

model Order {
  id            String               @id @default(cuid())
  orderRef      String               @unique @map("order_ref")
  customer      String
  channel       Channel              @default(WhatsApp)
  status        OrderStatus          @default(MENUNGGU)
  priority      Priority             @default(NORMAL)
  note          String?
  createdAt     DateTime             @default(now()) @map("created_at")
  cookStartedAt DateTime?            @map("cook_started_at")
  completedAt   DateTime?            @map("completed_at")
  customerEmail String?              @map("customer_email")
  customerId    String?              @map("customer_id")
  customerPhone String?              @map("customer_phone")
  deliveryAddr  String?              @map("delivery_address")
  deliveryFee   Float                @default(0) @map("delivery_fee")
  discount      Float                @default(0)
  subtotal      Float                @default(0)
  totalAmount   Float                @default(0) @map("total_amount")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  clientRef     Customer?            @relation(fields: [customerId], references: [id])
  payments      Payment[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  name      String
  qty       Int      @default(1)
  notes     String?
  orderId   String   @map("order_id")
  price     Float    @default(0)
  productId String?  @map("product_id")
  subtotal  Float    @default(0)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @map("order_id")
  paymentMethod PaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  amount        Float
  paidAt        DateTime?     @map("paid_at")
  proofUrl      String?       @map("proof_url")
  referenceCode String?       @map("reference_code")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  note      String?
  actor     String?     @default("SYSTEM")
  createdAt DateTime    @default(now()) @map("created_at")
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

model WebThemeSetting {
  id               String   @id @default(cuid())
  brandName        String   @default("Baitybites") @map("brand_name")
  tagline          String   @default("Bite The Best")
  heroTitle        String   @default("Sensasi Risol Mayo Meleleh") @map("hero_title")
  heroTitleAccent  String   @default("Double Cheese & Smoked Beef") @map("hero_title_accent")
  heroDescription  String   @map("hero_description")
  heroImage        String   @default("/images/backgrounds/hero-risol.jpg") @map("hero_image")
  primaryColor     String   @default("#F97316") @map("primary_color")
  accentColor      String   @default("#10B981") @map("accent_color")
  whatsappNumber   String   @default("+62 812 0000 0000") @map("whatsapp_number")
  instagramUrl     String?  @default("https://instagram.com/baitybites") @map("instagram_url")
  announcementText String?  @map("announcement_text")
  isActive         Boolean  @default(true) @map("is_active")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("web_theme_settings")
}

model GalleryItem {
  id           String          @id @default(cuid())
  title        String
  description  String?
  imageUrl     String          @map("image_url")
  category     GalleryCategory @default(PRODUK)
  displayOrder Int             @default(0) @map("display_order")
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@map("gallery_items")
}

model CustomerTestimonial {
  id           String   @id @default(cuid())
  author       String
  role         String?  @default("Pelanggan Setia")
  city         String?  @default("Jakarta")
  quote        String
  rating       Int      @default(5)
  avatarUrl    String?  @map("avatar_url")
  isFeatured   Boolean  @default(true) @map("is_featured")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("customer_testimonials")
}

model Admin {
  id           String    @id @default(cuid())
  username     String    @unique
  displayName  String    @map("display_name")
  passwordHash String    @map("password_hash")
  pinHash      String?   @map("pin_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    String?   @map("created_by")

  @@map("admins")
}

enum Channel {
  WhatsApp
  Tokopedia
  Shopee
  WalkIn
  Website

  @@map("channel")
}

enum OrderStatus {
  MENUNGGU
  DIMASAK
  SIAP_PICKUP
  DIKONFIRMASI
  DIKIRIM
  SELESAI
  DIBATALKAN

  @@map("order_status")
}

enum Priority {
  NORMAL
  URGENT

  @@map("priority")
}

enum CustomerType {
  REGULAR
  VIP
  WHOLESALE

  @@map("customer_type")
}

enum PaymentMethod {
  BANK_TRANSFER
  QRIS
  CASH
  COD
  EWALLET

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum GalleryCategory {
  PRODUK
  PROSES_DAPUR
  EVENT_HAMPERS
  TESTIMONI

  @@map("gallery_category")
}
